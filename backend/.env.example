# Copy to backend/.env and fill in. .env is gitignored; this file is not.

# ── Core ──────────────────────────────────────────────────────────────────────
# Required whenever DEBUG is False — prod.py refuses to start without it.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Public URL of the React frontend. Spectator links are built from this.
SITE_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres only. Create the local database first:
#   createdb shim   (or:  psql -U postgres -c "CREATE DATABASE shim;")
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shim
DB_CONN_MAX_AGE=600

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# ── Google sign-in ────────────────────────────────────────────────────────────
# OAuth client ID from Google Cloud Console (APIs & Services > Credentials >
# Create credentials > OAuth client ID > Web application).
#
# Authorised JavaScript origins must list the frontend origin exactly:
#   http://localhost:5173     (development)
#   https://shimgen.com       (production)
#
# No redirect URI is needed — Google Identity Services returns the token to the
# page rather than redirecting. The client ID is public and ships in the
# frontend bundle; the client *secret* is not used here, so do not add it.
#
# Leave empty to disable Google sign-in: the button hides itself and the form
# falls back to email and password.
GOOGLE_CLIENT_ID=

# ── Realtime ──────────────────────────────────────────────────────────────────
# Development uses an in-memory channel layer and ignores this. Set USE_REDIS=true
# to exercise the real Redis fanout locally before deploying.
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS=false

# ── Email ─────────────────────────────────────────────────────────────────────
# Development prints mail to the console. In production set:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@shimgen.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

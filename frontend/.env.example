# Copy to frontend/.env.local for local overrides. Vite exposes ONLY variables
# prefixed VITE_, and every one of them is readable in the shipped bundle —
# never put a secret here.

# Left unset in development so Vite's dev proxy (vite.config.js) forwards
# /api to the Django server, keeping requests same-origin and CORS-free.
# In production set this to the deployed API, e.g. https://api.shim.gg/api/v1
# VITE_API_BASE_URL=/api/v1

# Derived from window.location when unset, so it follows http/https correctly.
# VITE_WS_BASE_URL=wss://api.shim.gg/ws
